<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Student & Subject Management' %></title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link href="https://fonts.cdnfonts.com/css/manrope" rel="stylesheet">
</head>
<body>
    <div class="dashboard">
    <aside class="sidebar" id="sidebar">
        <img src="/img/logo.png" width="150px" class="logo" alt="students">
  
        <nav>
          <ul>
            <a href="/dashboard"><li class="<%= path === '/dashboard' ? 'active' : '' %>"><i class="fa fa-home"></i> Home</li></a>
            <a href="/students"><li class="<%= path === '/students' ? 'active' : '' %>"><i class="fa fa-users"></i> Students</li></a>
            <a href="/upload"><li class="<%= path === '/upload' ? 'active' : '' %>"><i class="fa-solid fa-upload"></i> Upload Result</li></a>
            <a href="/review"><li class="<%= path === '/review' ? 'active' : '' %>"><i class="fa-solid fa-eye"></i> View Result</li></a>
            <a href="/settings"><li class="<%= path === '/settings' ? 'active' : '' %>"><i class="fa fa-cog"></i> Settings</li></a>
            <a href="/logout"><li><i class="fa-solid fa-right-from-bracket"></i> Logout</li></a>
          </ul>
        </nav>
      </aside>
  
      <!-- header -->
      <main class="main-content">
        <header> 
          <h1>Student</h1><i class="fa fa-users"></i>
          <button id="menu-btn" class="menu-btn">
            <i class="fa fa-bars"></i>
          </button>
        </header>

        <!-- STUDENT MANAGEMENT -->
        <section class="cards">
          <div class="card student-card">
            <section id="students-section" class="visible">
              <h2><i class="fa-solid fa-user-tie"></i> Student Management</h2>
              <form id="student-form" class="student-form">
                <h3>Search Student by name or Class</h3>
                <input type="text" id="student-name" placeholder="Student Name" required> <br>
                <button type="submit">Add Student</button>
              </form>
      
              <table id="student-table">
                <thead>
                  <tr>
                    <th>Name</th>
                    <th>Class</th>
                    <th>Session</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (locals.students && students.length > 0) { %>
                    <% students.forEach(student => { %>
                      <tr>
                        <td><%= student.name %></td>
                        <td><%= student.class %></td>
                        <td><%= student.session %></td>
                        <td>...</td>
                      </tr>
                    <% }) %>
                  <% } %>
                </tbody>
              </table>
            </section>
          </div>
        </section>

        <!-- SUBJECT MANAGEMENT -->
        <div class="card student-card">
          <section id="subjects-section">
            <h2><i class="fa-solid fa-clipboard-list"></i> Subject Management</h2>
      
            <form id="subject-form">
              <input type="text" id="subject-name" placeholder="Subject Name" required> <br>
              <button type="submit">Add Subject</button>
            </form>
      
            <table id="subject-table">
              <thead>
                <tr>
                  <th>Subject Name</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% if (locals.subjects && subjects.length > 0) { %>
                  <% subjects.forEach(subject => { %>
                    <tr>
                      <td><%= subject.name %></td>
                      <td>...</td>
                    </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </section>
        </div>
      </main>
    </div>
    
    <script>
        const menuBtn = document.getElementById('menu-btn');
        const sidebar = document.getElementById('sidebar');
        menuBtn.addEventListener('click', () => {
          sidebar.classList.toggle('active');
        });
    </script>
</body>
</html>
