
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Teacher Sign Up' %></title>
    <link rel="stylesheet" href="/style.css">
    <link href="https://fonts.cdnfonts.com/css/manrope" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
</head>
<body>
    <div class="bg"></div>

    <div class="form-container">
        <img src="/img/logo-removebg-preview.png" width="600px" alt="students">

        <form action="/teacher/signup" method="POST">
            <h1 style="text-align: center; color: red;">Teacher Sign Up</h1>
            <br>

            <% if (locals.error) { %>
                <p style="color: red; text-align: center;"><%= error %></p>
            <% } %>

            <% if (locals.success) { %>
                <p style="color: green; text-align: center;"><%= success %></p>
            <% } %>

            <div class="input-container">
                <label for="name">Full Name</label> <br>
                <i class="fa fa-user"></i>
                <input
                    type="text"
                    id="name"
                    name="name"
                    placeholder="Enter your full name"
                    required
                >
            </div>

            <div class="input-container">
                <label for="email">Email Address</label> <br>
                <i class="fa fa-envelope"></i>
                <input
                    type="email"
                    id="email"
                    name="email"
                    placeholder="Enter your email address"
                    required
                >
            </div>

            <div class="input-container">
                <label for="password">Password</label> <br>
                <i class="fa fa-lock"></i>
                <input
                    type="password"
                    id="password"
                    name="password"
                    placeholder="Create a password"
                    minlength="8"
                    required
                >
            </div>

            <button type="submit">Create Account</button>

            <p style="text-align: center; margin-top: 15px;">
                Already have an account?
                <a href="/teacher/login">Login</a>
            </p>
        </form>
    </div>
</body>
</html>
