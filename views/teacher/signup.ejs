<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Teacher Sign Up' %></title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="/css/teacher-style.css">
    <link href="https://fonts.cdnfonts.com/css/manrope" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <style>
        .signup-badge {
            display: inline-block;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 800;
            padding: 4px 12px;
            border-radius: 12px;
            background: #e0f2fe;
            color: #0369a1;
            margin-bottom: 8px;
        }
        .login-link {
            text-align: center;
            margin-top: 20px;
            padding-top: 15px;
            border-top: 1px solid rgba(255, 255, 255, 0.2);
            font-size: 14px;
            color: #e2e8f0;
        }
        .login-link a {
            color: #ffffff;
            font-weight: 700;
            text-decoration: underline;
        }
        .login-link a:hover {
            color: #bae6fd;
        }
    </style>
</head>
<body>
    <div class="bg"></div>

    <div class="form-container">
        <div style="text-align: center;">
            <img src="/img/logo-removebg-preview.png" style="max-width: 220px; height: auto; margin-bottom: 10px;" alt="School Logo">
            <div><span class="signup-badge">Teacher Portal</span></div>
        </div>

        <form action="/teacher/signup" method="POST" id="teacherSignupForm">
            <h1 style="text-align: center; color: #ffffff; font-size: 24px; margin-bottom: 15px;">Teacher Registration</h1>

            <% if (typeof error !== 'undefined' && error) { %>
                <div style="background: rgba(239, 68, 68, 0.2); border-left: 4px solid #ef4444; color: #fee2e2; padding: 10px 14px; border-radius: 6px; margin-bottom: 16px; font-size: 14px; display: flex; align-items: center; gap: 8px;">
                    <i class="fa fa-exclamation-circle"></i>
                    <span><%= error %></span>
                </div>
            <% } %>

            <% if (typeof success !== 'undefined' && success) { %>
                <div style="background: rgba(34, 197, 94, 0.2); border-left: 4px solid #22c55e; color: #dcfce7; padding: 10px 14px; border-radius: 6px; margin-bottom: 16px; font-size: 14px; display: flex; align-items: center; gap: 8px;">
                    <i class="fa fa-check-circle"></i>
                    <span><%= success %></span>
                </div>
            <% } %>

            <div class="input-container">
                <label for="name">Full Name</label> <br>
                <i class="fa fa-user"></i>
                <input
                    type="text"
                    id="name"
                    name="name"
                    placeholder="e.g. John Doe"
                    value="<%= typeof name !== 'undefined' ? name : '' %>"
                    required
                    autocomplete="name"
                >
            </div>

            <div class="input-container">
                <label for="email">Email Address</label> <br>
                <i class="fa fa-envelope"></i>
                <input
                    type="email"
                    id="email"
                    name="email"
                    placeholder="e.g. john.doe@alcimfa.edu"
                    value="<%= typeof email !== 'undefined' ? email : '' %>"
                    required
                    autocomplete="email"
                >
            </div>

            <div class="input-container">
                <label for="password">Password</label> <br>
                <i class="fa fa-lock"></i>
                <input
                    type="password"
                    id="password"
                    name="password"
                    placeholder="Create a secure password (min 6 chars)"
                    minlength="6"
                    required
                    autocomplete="new-password"
                >
            </div>

            <button type="submit" id="submitBtn">Register as Teacher</button>

            <div class="login-link">
                Already registered as a teacher?
                <a href="/admin/login"><i class="fa fa-arrow-right-to-bracket"></i> Sign In to Staff Portal</a>
            </div>
        </form>
    </div>
</body>
</html>

